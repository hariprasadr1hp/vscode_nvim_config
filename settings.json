//settings.json
{
  //###############################################
  // TELEMETRY   ##################################
  //###############################################
  "code-runner.enableAppInsights": false,
  "gitlens.telemetry.enabled": false,
  "postman.telemetry.enabled": false,
  "jupyter.experiments.enabled": false,
  "jupyter.experiments.optInto": [],
  "jupyter.experiments.optOutFrom": [],
  "python.analysis.reportExtraTelemetry": false,
  "python.experiments.enabled": false,
  "python.experiments.optInto": [],
  "python.experiments.optOutFrom": [],
  "redhat.telemetry.enabled": false,
  "telemetry.telemetryLevel": "off",
  //###############################################
  // SECURITY/PRIVACY   ###########################
  //###############################################
  "github-actions.use-enterprise": false,
  "gitlens.ai.experimental.generateCommitMessage.enabled": false,
  "gitlens.cloudIntegrations.enabled": false,
  "gitlens.integrations.enabled": false,
  "gitlens.liveshare.enabled": false,
  "security.workspace.trust.untrustedFiles": "open",
  //###############################################
  // GUI CONFIG   #################################
  //###############################################
  "editor.accessibilitySupport": "off",
  "editor.cursorBlinking": "solid",
  "editor.fontSize": 16,
  // "editor.formatOnPaste": true,
  "editor.formatOnSave": true,
  // "editor.formatOnType": true,
  "editor.guides.indentation": false,
  "editor.guides.highlightActiveIndentation": false,
  "editor.inlayHints.enabled": "off",
  "editor.lineNumbers": "relative",
  "editor.renderLineHighlight": "none",
  "editor.renderWhitespace": "none",
  "editor.rulers": [
    74
  ],
  "editor.minimap.enabled": false,
  "editor.multiCursorModifier": "ctrlCmd",
  "editor.quickSuggestions": {
    "other": true,
    "comments": false,
    "strings": true
  },
  "editor.semanticHighlighting.enabled": true,
  "editor.stickyScroll.enabled": false,
  "files.associations": {
    "*.sql": "jinja-sql",
    "*.yml": "jinja-yaml"
  },
  "window.commandCenter": false,
  "window.customTitleBarVisibility": "never",
  "window.menuStyle": "custom",
  "window.nativeTabs": true,
  "window.nativeFullScreen": false,
  "window.titleBarStyle": "native",
  "workbench.activityBar.location": "hidden",
  "workbench.colorTheme": "Mermaid Dark",
  "workbench.editor.enablePreviewFromQuickOpen": false,
  "workbench.editor.highlightModifiedTabs": true,
  "workbench.editor.showTabs": "none",
  "workbench.settings.editor": "json",
  "workbench.settings.openDefaultSettings": true,
  "workbench.settings.useSplitJSON": true,
  "workbench.sideBar.location": "left",
  "zenMode.fullScreen": false,
  "zenMode.hideLineNumbers": false,
  "zenMode.hideStatusBar": true,
  "zenMode.showTabs": "none",
  "zenMode.silentNotifications": false,
  //###############################################
  // TERMINAL   ###################################
  //###############################################
  "terminal.explorerKind": "external",
  "terminal.integrated.allowedLinkSchemes": [
    "docker-desktop",
    "file",
    "http",
    "https",
    "mailto",
    "vscode",
    "vscode-insiders"
  ],
  "terminal.integrated.fontSize": 16,
  "terminal.integrated.inheritEnv": false,
  //###############################################
  // NEOVIM   #####################################
  //###############################################
  "vscode-neovim.neovimInitVimPaths.linux": "~/.config/nvim/init.lua",
  "vscode-neovim.neovimExecutablePaths.linux": "~/.local/bin/nvim",
  "vscode-neovim.neovimInitVimPaths.darwin": "~/.config/nvim/init.lua",
  "vscode-neovim.neovimExecutablePaths.darwin": "/opt/homebrew/bin/nvim",
  "extensions.experimental.affinity": {
    "asvetliakov.vscode-neovim": 1
  },
  "vscode-neovim.logOutputToConsole": true,
  //###############################################
  // KUBERNETES ###################################
  //###############################################
  "vs-kubernetes": {
    "vscode-kubernetes.minikube-path.mac": "~/.vs-kubernetes/tools/minikube/darwin-arm64/minikube",
    "vscode-kubernetes.helm-path.mac": "~/.vs-kubernetes/tools/helm/darwin-arm64/helm",
    "vscode-kubernetes.helm-path-mac": "~/.vs-kubernetes/tools/helm/darwin-arm64/helm"
  },
  //###############################################
  // CODING ENVIRONMENT   #########################
  //###############################################
  "code-runner.clearPreviousOutput": true,
  "code-runner.showExecutionMessage": false,
  //############### CMAKE #########################
  "cmake.showOptionsMovedNotification": false,
  //################ CPP ##########################
  "[cpp]": {
    "editor.tabSize": 4,
    "editor.wordBasedSuggestions": "off"
  },
  //################ CSS ##########################
  "[css]": {
    "editor.tabSize": 2,
    "editor.codeActionsOnSave": {
      "source.fixAll.biome": "explicit"
    }
  },
  //############### DBT #########################
  "dbt.lineage.defaultDepth": 0,
  //############### HTML ########################
  "[html]": {
    "editor.tabSize": 2,
    "editor.codeActionsOnSave": {
      "source.fixAll.biome": "explicit"
    }
  },
  //############### HTTP ##########################
  "http.proxySupport": "off",
  //############## JAVASCRIPT #####################
  "[javascript]": {
    "editor.tabSize": 2,
    "editor.codeActionsOnSave": {
      "source.fixAll.biome": "explicit"
    }
  },
  //################ JSON #########################
  "[json]": {
    "editor.tabSize": 2,
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.fixAll.biome": "explicit"
    }
  },
  //############### JSONC #########################
  "[jsonc]": {
    "editor.defaultFormatter": "vscode.json-language-features"
  },
  //############### LATEX #########################
  "latex-workshop.view.pdf.viewer": "tab",
  //############### MAGIT #########################
  "[magit]": {
    "editor.lineNumbers": "on",
    "editor.minimap.enabled": false,
    "editor.renderWhitespace": "none"
  },
  //############## MARKDOWN #######################
  "ruff.format.preview": true,
  "[markdown]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "charliermarsh.ruff"
  },
  //############## MERMAID ########################
  "mermaid-chat.enabled": false,
  //############### NOTEBOOK ######################
  "notebook.formatOnSave.enabled": true,
  // "notebook.lineNumbers": "on",
  "notebook.codeActionsOnSave": {
    "notebook.source.fixAll": "explicit",
    "notebook.source.organizeImports": "explicit"
  },
  "notebook.output.textLineLimit": 100,
  "workbench.editorAssociations": {
    "*.ipynb": "jupyter.notebook.ipynb"
  },
  //############### PYTHON ########################
  "code-runner.executorMap": {
    "python": "$pythonPath -u $fullFileName"
  },
  "[python]": {
    "editor.tabSize": 4,
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.codeActionsOnSave": {
      "source.fixAll": "explicit",
      "source.organizeImports": "explicit"
    }
  },
  //############### RUST ##########################
  // "rust-analyzer.check.command": "check",
  "[rust]": {
    "editor.tabSize": 4,
    "editor.wordBasedSuggestions": "off"
  },
  //############### SQL ########################
  "[sql]": {
    "editor.tabSize": 2
  },
  //################ SVG ##########################
  "svg.preview.mode": "svg",
  //############## TYPESCRIPT #####################
  "[typescript]": {
    "editor.tabSize": 2,
    "editor.codeActionsOnSave": {
      "source.fixAll.biome": "explicit"
    }
  },
  //############### SCSS ##########################
  "[scss]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  //############### VITE ##########################
  "vite.autoStart": false,
  "oxc_language_server.enable": true,
  //############### VUE ###########################
  "[vue]": {
    "editor.tabSize": 2,
    "editor.defaultFormatter": "Vue.volar"
  },
  //############### YAML ##########################
  "[yaml]": {
    "editor.tabSize": 2,
    "editor.defaultFormatter": "redhat.vscode-yaml"
  },
  "yaml.schemas": {},
  "[jinja-yaml]": {
    "editor.tabSize": 2,
    "editor.defaultFormatter": "redhat.vscode-yaml"
  },
  "yaml.completion": true,
  "yaml.extension.recommendations": "true",
  "yaml.format.singleQuote": false,
  "yaml.hover": true,
  "yaml.schemaStore.enable": true,
  "yaml.schemaStore.url": "https://www.schemastore.org/api/json/catalog.json",
  "workbench.startupEditor": "none",
  "json.schemaDownload.trustedDomains": {
    "https://schemastore.azurewebsites.net/": true,
    "https://raw.githubusercontent.com/microsoft/vscode/": true,
    "https://raw.githubusercontent.com/devcontainers/spec/": true,
    "https://www.schemastore.org/": true,
    "https://json.schemastore.org/": true,
    "https://json-schema.org/": true,
    "https://developer.microsoft.com/json-schemas/": true,
    "https://biomejs.dev": true
  }
}